{
  "name": "kotostok",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "bun-tasks": "^0.1.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "private": true,
  "scripts": {
    "dev:backend": "cd apps/backend && bun run start:dev",
    "dev:frontend": "cd apps/frontend && bun run dev",
    "dev": "bun-tasks dev:backend ::: dev:frontend",
    "prod:frontend": "cd apps/frontend && bun run build && PORT=1337 bun --bun server.ts",
    "prod:backend": "cd apps/backend && bun run build && bun run start:prod",
    "prod": "bun-tasks prod:frontend ::: prod:backend",
    "migration": "cd apps/backend && bun migration"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "badlib": "^0.2.9"
  }
}
