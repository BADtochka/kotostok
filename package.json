{
  "name": "kotostok",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "^1.3.9"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "private": true,
  "scripts": {
    "dev:backend": "cd apps/backend && bun run start:dev",
    "dev:frontend": "cd apps/frontend && bun run dev",
    "dev": "bun run-p -l dev:backend dev:frontend",
    "migration": "cd apps/backend && bun migration"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "badlib": "^0.2.9",
    "npm-run-all2": "^8.0.4"
  }
}
